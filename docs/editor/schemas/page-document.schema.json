{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sane-living:editor:page-document:1",
  "title": "Proposed Sane Living page document v1",
  "description": "Structural envelope only. Apply component, binding, routing, safety and total tree semantic validation before saving/publishing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "route",
    "title",
    "templateVersion",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "route": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^/(?:[a-z0-9]+(?:-[a-z0-9]+)*/)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "templateVersion": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*@\\d+$",
      "maxLength": 80
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 320
        },
        "image": {
          "type": "string",
          "maxLength": 2048
        }
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "key"
      ],
      "properties": {
        "resource": {
          "enum": [
            "settings",
            "about",
            "gallery",
            "pricing",
            "partners",
            "weddings",
            "events:published"
          ]
        },
        "key": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z][A-Za-z0-9_-]*)*$"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "enum": [
            "narrow",
            "content",
            "wide",
            "full"
          ]
        },
        "spacing": {
          "enum": [
            "none",
            "small",
            "medium",
            "large"
          ]
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end"
          ]
        },
        "mobile": {
          "$ref": "#/$defs/layoutOverride"
        },
        "tablet": {
          "$ref": "#/$defs/layoutOverride"
        }
      }
    },
    "layoutOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spacing": {
          "enum": [
            "none",
            "small",
            "medium",
            "large"
          ]
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end"
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "componentVersion",
        "variant",
        "props"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "type": "string",
          "pattern": "^sane\\.[A-Za-z][A-Za-z0-9]*$",
          "maxLength": 80
        },
        "componentVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "variant": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 60
        },
        "props": {
          "type": "object",
          "maxProperties": 50
        },
        "bindings": {
          "type": "object",
          "maxProperties": 30,
          "propertyNames": {
            "pattern": "^[a-z][a-zA-Z0-9]*$",
            "not": {
              "enum": [
                "constructor",
                "prototype",
                "__proto__"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/binding"
          }
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "slots": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[a-z][a-zA-Z0-9]*$"
          },
          "additionalProperties": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "$ref": "#/$defs/node"
            }
          }
        }
      }
    }
  }
}
