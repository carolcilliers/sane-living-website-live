# Sane Living — required environment variables (names only, no values).
# Set the real values in Vercel: Project Settings -> Environment Variables
# (Preview + Production). NEVER commit real values to this repository.

# --- Team dashboard / Decap login (required for /dash and /admin saves) ---
# Username for the team login (optional — defaults to "saneliving")
CMS_LOGIN_USER=
# Password for the team login (set by Carol; never share in chat or email)
CMS_LOGIN_PASSWORD=
# Fine-grained GitHub token, Contents read/write on THIS repository only.
# The dashboards use it server-side to save content as commits.
CMS_GITHUB_TOKEN=

# --- Airtable calendar (required for event management + this deployment's events feed) ---
# Airtable personal access token with data.records read+write on the events base
AIRTABLE_API_TOKEN=
# Airtable base ID (starts with "app...")
AIRTABLE_BASE_ID=
# Optional: calendar table ID override (defaults to the built-in calendar table)
AIRTABLE_CALENDAR_TABLE=

# --- Optional dashboard overrides ---
# Branch the dashboard saves content to (defaults to "main")
DASH_BRANCH=
# Read-only fallback feed used when Airtable keys are absent (defaults to the live site feed)
LIVE_EVENTS_FEED_URL=
